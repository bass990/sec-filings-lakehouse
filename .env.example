# Copy to .env. Defaults run the whole platform locally with docker compose.

# ---- identity the SEC requires on every request (their fair-access policy) ----
SEC_USER_AGENT="sec-lakehouse portfolio you@example.com"

# ---- storage target: local | aws | azure | gcp -------------------------------
LAKEHOUSE_TARGET=local
LAKEHOUSE_BUCKET=sec-lakehouse

# local (the compose object store: RustFS by default, MinIO-compatible; the variable names are historical)
MINIO_ROOT_USER=lakehouse
MINIO_ROOT_PASSWORD=lakehouse-local
S3_ENDPOINT_URL=http://localhost:9000
ICEBERG_REST_URI=http://localhost:8181

# aws (uses the default AWS CLI credentials; provisioned by deploy/aws)
# AWS_REGION=us-east-2
# LAKEHOUSE_BUCKET=sec-lakehouse-bass990        # created by deploy/aws
# (Glue databases silver + gold are created by deploy/aws)

# ---- postgres + pgvector (vector index, serving tables, lineage) --------------
PG_USER=lakehouse
PG_PASSWORD=lakehouse-local
PG_DB=lakehouse
PG_HOST=localhost
PG_PORT=5433

# ---- embeddings + answers -----------------------------------------------------
# local CPU model, free, 384 dims
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# only the RAG answer endpoint needs it
ANTHROPIC_API_KEY=
ANSWER_MODEL=claude-haiku-4-5-20251001

# ---- limits ---------------------------------------------------------------------
MAX_FILINGS_PER_RUN=200
